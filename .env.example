# Copy to `.env.local` and fill in. NEVER commit `.env.local`.

# WalletConnect project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc Mainnet parameters — LEAVE BLANK until Circle publishes them.
# When mainnet launches, fill these in to enable mainnet support.
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=

# Deployed contract addresses are read from lib/deployments/<chainId>.json
# (generated by the contracts deploy script).
